{
  "basic": [
    {
      "id": "1",
      "filter": "div#case1.target:has(li:has-text(/[0-9]/))",
      "title": "has()의 중첩 확장 CSS 테스트",
      "desc": "has()의 기본적인 중첩 유형을 테스트합니다.",
      "target": "<div id=\"case1\" class=\"target\"><ul><li>123</li></ul></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "2",
      "filter": "h1#case2.target:has(> span:has-text(/[0-9]/))",
      "title": "중첩 확장 CSS prefix 테스트",
      "desc": "중첩 시 Argument의 시작이 <code>></code>인 경우를 테스트합니다.",
      "target": "<h1 id=\"case2\" class=\"target\"><span>1</span></h1>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "3",
      "filter": "#case3.target > h1:has(> span:has-text(/[0-9]/)):upward(1)",
      "title": "중첩 확장 CSS + 조합 테스트",
      "desc": "중첩 및 조합한 경우를 테스트합니다.",
      "target": "<div id=\"case3\" class=\"target\"><h1><span>999</span></h1></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "4",
      "filter": "#case4 > li.target:matches-css(color: rgb(0, 0, 255))",
      "title": "matches-css() 특수 케이스 테스트",
      "desc": "matches-css() css value가 괄호를 포함한 경우를 테스트합니다.",
      "target": "<div id=\"case4\"><li class=\"target\" style=\"color:#0000ff\">Blue text</li></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "5",
      "filter": "#case5.target:has(> div:matches-css(background-color: rgb(0, 0, 255)))",
      "title": "중첩 시 matches-css() 특수 케이스 테스트",
      "desc": "중첩 시 matches-css() css value가 괄호를 포함한 경우를 테스트합니다.",
      "target": "<div id=\"case5\" class=\"target\"><div style=\"background-color:#0000ff;\">Blue BG</div></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "6",
      "filter": "div#case6.target:matches-css(border-width: /\\b(1px|2px)\\b/)",
      "title": "matches-css 정규식 - border(shorthand)",
      "desc": "1px|2px, solid, #000 또는 000 허용을 테스트합니다.",
      "target": "<div id=\"case6\" class=\"target\" style=\"border: 2px solid #000; width:120px; height:36px;\">border 테스트</div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "7",
      "filter": "div#case7.target:matches-css(background: /linear-gradient\\(/)",
      "title": "matches-css 정규식 - linear-gradient",
      "desc": "background에 linear-gradient(...) 포함 여부를 테스트합니다.",
      "target": "<div id=\"case7\" class=\"target\" style=\"background: linear-gradient(90deg, #000, #fff); width:120px; height:36px;\">gradient 테스트</div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "8",
      "filter": "span#case8.target:matches-css(color: /rgb\\(0,\\s*0,\\s*255\\)/)",
      "title": "matches-css 정규식 - color 매칭",
      "desc": "color 속성의 정규표현식 매칭을 테스트합니다.",
      "target": "<span id=\"case8\" class=\"target\" style=\"color: rgb(0, 0, 255);\">color 테스트</span>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "9",
      "filter": "div#case9.target:has(li:has-text(/[0-9]/), ol)",
      "title": "has()의 다중Param 테스트",
      "desc": "has()의 Argument가 확장 CSS를 포함하며 다수인 경우를 테스트합니다.",
      "target": "<div id=\"case9\" class=\"target\"><ul><li>456</li></ul><ol><li>Text only</li></ol></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "10",
      "filter": "#case10 li.target:not(li:has-text(/[0-9]/))",
      "title": "not()의 중첩 확장 CSS 테스트",
      "desc": "not()의 기본적인 중첩 유형을 테스트합니다.",
      "target": "<div id=\"case10\"><ul><li class=\"target\">No digits here</li></ul></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "11",
      "filter": ":has(h1#case11:has-text(/E/)) h1:upward(.target)",
      "title": "Root Subject 테스트",
      "desc": "Root에서 확장 CSS를 사용할 때 Subject가 없는 경우를 테스트합니다.",
      "target": "<div class=\"target\"><h1 id=\"case11\">Example</h1></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "12",
      "filter": "#case12.target > li:not(:upward(ol) > li):upward(1)",
      "title": "Argument Subject 테스트(with not())",
      "desc": "Argument의 Root가 확장 CSS이며 Subject가 없을 경우를 테스트합니다.",
      "target": "<div id=\"case12\" class=\"target\"><li>Outside OL</li></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "13",
      "filter": "#case13 h1.target:has(:matches-css(color: rgb(255, 0, 0)))",
      "title": "Argument Subject 테스트(with has())",
      "desc": "Argument의 Root가 확장 CSS이며 Subject가 없을 경우를 테스트합니다.",
      "target": "<div id=\"case13\"><h1 class=\"target\" style=\"color:#ff0000;\">Title <span>Red</span></h1></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "14",
      "filter": "div#case14.target:has(li) > :upward(1)",
      "title": "Path Subject 테스트",
      "desc": "Path에서 확장 CSS를 사용할 때 Subject가 없는 경우를 테스트합니다.",
      "target": "<div id=\"case14\" class=\"target\"><ul><li>List item</li></ul></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "15",
      "filter": "h1#case15:has(> span:has-text(/[0-9]/)):upward(1) ~ :has(ul) ul.target",
      "title": "복잡한 확장 CSS 테스트",
      "desc": "복잡한 selector 테스트입니다.",
      "target": "<div><div><h1 id=\"case15\"><span>999</span></h1></div><div><ul class=\"target\"><li>Some item</li></ul></div></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "16",
      "filter": "div#case16:has(li) > ul:upward(1) li.target",
      "title": "확장 CSS 테스트",
      "desc": "일반적인 케이스 테스트입니다.",
      "target": "<div id=\"case16\" class=\"target\"><ul><li class=\"target\">Item 13</li></ul></div>",
      "checkStyle": { "display": "none" }
    },
    {
      "id": "17",
      "filter": "#case17 > div.target:not([id]):matches-css(background-color: rgb(255, 254, 249)):has(+ div:not([id]))",
      "title": "버그 케이스 - 1",
      "desc": "버그 케이스",
      "target": "<div id=\"case17\"><div class=\"target\" style=\"background-color: rgb(255, 254, 249);\"><p>이 div는 .target 클래스이고, ID가 없습니다.</p><p>배경색은 #fffef9 (rgb(255, 254, 249)) 입니다.</p></div><div><p>이것은 .target 바로 뒤에 오는 div이며, ID가 없습니다.</p></div></div>",
      "checkStyle": { "display": "none" }
    }
  ],
  "style": [
    {
      "id": "1",
      "filter": "div#case1.target:has-text(font-test):style(font-size: 32px)",
      "title": "style() 테스트",
      "desc": "style()의 기본 형태를 테스트합니다.",
      "target": "<div id=\"case1\" class=\"target\">font-test</div>",
      "checkStyle": { "fontSize": "32px" }
    },
    {
      "id": "2",
      "filter": "div#case2.target:has-text(background-test):style(background-color: rgb(255, 0, 0))",
      "title": "style() 테스트",
      "desc": "style()의 value에 괄호가 있을 경우를 테스트합니다.",
      "target": "<div id=\"case2\" class=\"target\">background-test</div>",
      "checkStyle": { "backgroundColor": "rgb(255, 0, 0)" }
    }
  ],
  "remove": [
    {
      "id": "1",
      "filter": "div#case1.target:has-text(remove-test):remove()",
      "title": "style() 테스트",
      "desc": "style()의 기본 형태를 테스트합니다.",
      "target": "<div id=\"case1\" class=\"target\">remove-test</div>"
    }
  ]
}