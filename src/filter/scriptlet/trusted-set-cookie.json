[
    {
        "id": "1",
        "title": "기본 trusted 쿠키 저장",
        "desc": "임의 문자열 custom-value를 Secure 쿠키에 저장",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["__Secure-tsc_basic", "custom-value"],
        "target": "<div class='target'></div>",
        "verification": "secureCookie:__Secure-tsc_basic:custom-value"
    },
    {
        "id": "2",
        "title": "expires 옵션",
        "desc": "1day 만료값이 현재 시각에서 약 하루 뒤로 설정됐는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_expires", "accepted", "1day"],
        "target": "<div class='target'></div>",
        "verification": "cookieAttribute:tsc_expires:accepted:expires:86400000"
    },
    {
        "id": "3",
        "title": "path 옵션",
        "desc": "none 값으로 Path 속성을 생략하고, 현재 URL에서 계산한 기본 Path가 실제로 적용됐는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_path", "accepted", "", "none"],
        "target": "<div class='target'></div>",
        "verification": "cookieAttribute:tsc_path:accepted:path:default"
    },
    {
        "id": "4",
        "title": "domain 정규표현식 옵션 (수동 확인)",
        "desc": "1. 규칙을 추가하고 페이지를 새로고침합니다.<br>2. 개발자 도구의 Application > Storage > Cookies에서 tsc_domain을 찾습니다.<br>3. Value가 accepted이고 Domain이 현재 페이지의 hostname과 같은지 확인합니다.",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_domain", "accepted", "", "", "domain", "/.*/"]
    },
    {
        "id": "5",
        "title": "dontOverwrite 옵션",
        "desc": "테스트 실행 시 쿠키가 없으면 replacement가 생성되고, 기존 tsc_dont_overwrite=custom-value는 덮어써지지 않는지 순서대로 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": [
            "tsc_dont_overwrite",
            "replacement",
            "",
            "",
            "dontOverwrite",
            "1"
        ],
        "target": "<div class='target'></div>",
        "setup": { "tsc_dont_overwrite": "custom-value" },
        "verification": "probeDontOverwriteCookie:tsc_dont_overwrite:custom-value:replacement"
    },
    {
        "id": "6",
        "title": "reload 옵션",
        "desc": "쿠키 변경 후 실제 페이지 리로드가 발생했는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_reload", "accepted", "", "", "reload", "1"],
        "target": "<div class='target'></div>",
        "setup": { "tsc_reload": null },
        "verification": "reloadCookie:tsc_reload:accepted:10000"
    },
    {
        "id": "7",
        "title": "$now$ 토큰",
        "desc": "$now$가 현재 시각의 밀리초 타임스탬프로 변환되어 쿠키에 저장되는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_now", "$now$"],
        "target": "<div class='target'></div>",
        "setup": { "tsc_now": null },
        "verification": "cookieTimeValue:tsc_now:now"
    },
    {
        "id": "8",
        "title": "$currentDate$ 토큰",
        "desc": "$currentDate$가 현재 시각의 UTC 날짜 문자열로 변환되어 쿠키에 저장되는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_current_date", "$currentDate$"],
        "target": "<div class='target'></div>",
        "setup": { "tsc_current_date": null },
        "verification": "cookieTimeValue:tsc_current_date:utc"
    },
    {
        "id": "9",
        "title": "$currentISODate$ 토큰",
        "desc": "$currentISODate$가 현재 시각의 ISO 8601 문자열로 변환되어 쿠키에 저장되는지 확인",
        "scriptlet": "trusted-set-cookie",
        "scriptletParams": ["tsc_current_iso_date", "$currentISODate$"],
        "target": "<div class='target'></div>",
        "setup": { "tsc_current_iso_date": null },
        "verification": "cookieTimeValue:tsc_current_iso_date:iso"
    }
]
