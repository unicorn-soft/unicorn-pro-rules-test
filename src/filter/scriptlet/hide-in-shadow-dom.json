[
    {
        "id": "1",
        "title": "Shadow DOM 요소 기본 숨김",
        "desc": "open Shadow DOM 안의 <code>.hisd_target_1</code> 요소를 숨긴다.",
        "scriptlet": "hide-in-shadow-dom",
        "scriptletParams": [".hisd_target_1"],
        "target": "<div class='target'><div id='hisd_host_1'><template shadowrootmode='open'><div class='hisd_target_1'>기본 숨김 대상</div></template></div><script>(function(){const host=document.getElementById('hisd_host_1');window.hisd_check_1=function(){const el=host.shadowRoot&&host.shadowRoot.querySelector('.hisd_target_1');return el!==null&&getComputedStyle(el).display==='none';};}());</script></div>",
        "verification": "functionCall:hisd_check_1:true"
    },
    {
        "id": "2",
        "title": "baseSelector로 Shadow Host 제한",
        "desc": "<code>.hisd_base_2</code> host 안의 대상만 숨기고 비교 대상은 유지한다.",
        "scriptlet": "hide-in-shadow-dom",
        "scriptletParams": [".hisd_target_2", ".hisd_base_2"],
        "showTarget": true,
        "comparison": {
            "leftLabel": "숨겨져야 하는 대상",
            "rightLabel": "계속 보여야 하는 대상",
            "leftVerification": "functionCall:hisd_check_2_left:true",
            "rightVerification": "functionCall:hisd_check_2_right:true"
        },
        "target": "<div class='target shadow-dom-case'><div class='shadow-comparison-content' data-shadow-side='left'><div class='hisd_base_2 shadow-demo-host'><template shadowrootmode='open'><div class='hisd_target_2' style='padding:0.75rem;background:#fee2e2;color:#7f1d1d;border:1px solid #fca5a5'>이 내용은 숨겨져야 함</div></template></div></div><div class='shadow-comparison-content' data-shadow-side='right'><div class='hisd_control_2 shadow-demo-host'><template shadowrootmode='open'><div class='hisd_target_2' style='padding:0.75rem;background:#fff;color:#166534;border:1px solid #86efac'>이 내용은 계속 보여야 함</div></template></div></div><script>(function(){const matchedHost=document.querySelector('.hisd_base_2');const controlHost=document.querySelector('.hisd_control_2');window.hisd_check_2_left=function(){const matched=matchedHost.shadowRoot&&matchedHost.shadowRoot.querySelector('.hisd_target_2');return matched!==null&&getComputedStyle(matched).display==='none';};window.hisd_check_2_right=function(){const control=controlHost.shadowRoot&&controlHost.shadowRoot.querySelector('.hisd_target_2');return window.hisd_check_2_left()&&control!==null&&getComputedStyle(control).display!=='none';};window.hisd_check_2=function(){return window.hisd_check_2_left()&&window.hisd_check_2_right();};}());</script></div>",
        "verification": "functionCall:hisd_check_2:true"
    },
    {
        "id": "3",
        "title": "중첩 Shadow DOM 요소 숨김",
        "desc": "Shadow Root 안에 중첩된 open Shadow Root까지 탐색해 대상을 숨긴다.",
        "scriptlet": "hide-in-shadow-dom",
        "scriptletParams": [".hisd_target_3"],
        "target": "<div class='target'><div id='hisd_host_3'><template shadowrootmode='open'><div class='hisd_inner_host_3'><template shadowrootmode='open'><div class='hisd_target_3'>중첩 숨김 대상</div></template></div></template></div><script>(function(){const outerHost=document.getElementById('hisd_host_3');window.hisd_check_3=function(){const innerHost=outerHost.shadowRoot&&outerHost.shadowRoot.querySelector('.hisd_inner_host_3');const el=innerHost&&innerHost.shadowRoot&&innerHost.shadowRoot.querySelector('.hisd_target_3');return el!==null&&getComputedStyle(el).display==='none';};}());</script></div>",
        "verification": "functionCall:hisd_check_3:true"
    },
    {
        "id": "4",
        "title": "동적으로 추가된 요소 숨김",
        "desc": "Shadow Root에 나중에 추가된 요소도 감지해 숨긴다.",
        "scriptlet": "hide-in-shadow-dom",
        "scriptletParams": [".hisd_target_4"],
        "target": "<div class='target'><div id='hisd_host_4'><template shadowrootmode='open'></template></div><script>(function(){const host=document.getElementById('hisd_host_4');const root=host.shadowRoot;let el=null;setTimeout(function(){el=document.createElement('div');el.className='hisd_target_4';el.textContent='동적 숨김 대상';root.appendChild(el);},100);window.hisd_check_4=function(){return el!==null&&el.getRootNode()===root&&getComputedStyle(el).display==='none';};}());</script></div>",
        "verification": "functionCall:hisd_check_4:true"
    }
