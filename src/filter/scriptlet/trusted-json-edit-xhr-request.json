[
  {
    "id": "1",
    "title": "기본 속성 삭제 (ads1)",
    "desc": "XHR 요청 body JSON의 ads1 속성을 삭제합니다",
    "scriptlet": "trusted-json-edit-xhr-request",
    "scriptletParams": [".ads1"],
    "target": "<div class='target'><script>window.tjexr1=null;var xhr1=new XMLHttpRequest();xhr1.open('POST','/api/edit-xhr-request-1');xhr1.setRequestHeader('Content-Type','application/json');xhr1.onload=function(){try{window.tjexr1=JSON.parse(xhr1.responseText);}catch(e){}};xhr1.send(JSON.stringify({ads1:1,content1:'keep',tracking1:'seoul'}));</script>요청 결과: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
    "verification": "jsonEquals:window.tjexr1:{\"content1\":\"keep\",\"tracking1\":\"seoul\"}:ads1 삭제됨"
  },
  {
    "id": "2",
