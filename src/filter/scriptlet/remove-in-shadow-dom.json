        "target": "<div class='target'><div id='risd_host_3'><template shadowrootmode='open'><div class='risd_inner_host_3'><template shadowrootmode='open'><div class='risd_target_3'>중첩 제거 대상</div></template></div></template></div><script>(function(){const outerHost=document.getElementById('risd_host_3');window.risd_check_3=function(){const innerHost=outerHost.shadowRoot&&outerHost.shadowRoot.querySelector('.risd_inner_host_3');return innerHost!==null&&innerHost.shadowRoot!==null&&innerHost.shadowRoot.querySelector('.risd_target_3')===null;};}());</script></div>",
