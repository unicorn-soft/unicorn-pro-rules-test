    {
        "id": "1",
        "title": "Shadow DOM 요소 기본 제거",
        "desc": "open Shadow DOM 안의 <code>.risd_target_1</code> 요소만 제거하고 비일치 형제 요소는 유지한다.",
        "scriptlet": "remove-in-shadow-dom",
        "scriptletParams": [".risd_target_1"],
        "target": "<div class='target'><div id='risd_host_1'><template shadowrootmode='open'><div class='risd_target_1'>기본 제거 대상</div><div class='risd_keep_1'>비일치 유지 대상</div></template></div><script>(function(){const host=document.getElementById('risd_host_1');const root=host.shadowRoot;const target=root&&root.querySelector('.risd_target_1');const keep=root&&root.querySelector('.risd_keep_1');window.risd_check_1=function(){return root!==null&&target!==null&&!target.isConnected&&root.querySelector('.risd_target_1')===null&&keep!==null&&keep.isConnected&&keep.getRootNode()===root&&root.querySelector('.risd_keep_1')===keep;};}());</script></div>",
        "verification": "functionCall:risd_check_1:true"
    },
    {
        "id": "2",
