            "leftVerification": "functionCall:risd_check_2_left:true",
            "rightVerification": "functionCall:risd_check_2_right:true"
        },
        "target": "<div class='target shadow-dom-case'><div class='shadow-comparison-content' data-shadow-side='left'><div class='risd_base_2 shadow-demo-host'><template shadowrootmode='open'><div class='risd_target_2' style='padding:0.75rem;background:#fee2e2;color:#7f1d1d;border:1px solid #fca5a5'>이 내용은 제거되어야 함</div></template></div></div><div class='shadow-comparison-content' data-shadow-side='right'><div class='risd_control_2 shadow-demo-host'><template shadowrootmode='open'><div class='risd_target_2' style='padding:0.75rem;background:#fff;color:#166534;border:1px solid #86efac'>이 내용은 계속 존재해야 함</div></template></div></div><script>(function(){const matchedHost=document.querySelector('.risd_base_2');const controlHost=document.querySelector('.risd_control_2');const matchedRoot=matchedHost.shadowRoot;const controlRoot=controlHost.shadowRoot;const matched=matchedRoot&&matchedRoot.querySelector('.risd_target_2');const control=controlRoot&&controlRoot.querySelector('.risd_target_2');window.risd_check_2_left=function(){return matched!==null&&!matched.isConnected&&matchedRoot.querySelector('.risd_target_2')===null;};window.risd_check_2_right=function(){return window.risd_check_2_left()&&control!==null&&control.isConnected&&controlRoot.querySelector('.risd_target_2')===control;};window.risd_check_2=function(){return window.risd_check_2_left()&&window.risd_check_2_right();};}());</script></div>",
        "verification": "functionCall:risd_check_2:true"
    },
