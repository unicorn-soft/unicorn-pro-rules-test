[
  {
    "id": "1",
    "title": "기본 속성 삭제 (ads1)",
    "desc": "body JSON의 ads1 속성을 삭제합니다",
    "scriptlet": "trusted-json-edit-fetch-request",
    "scriptletParams": [".ads1"],
    "target": "<div class='target'><script>window.tjefr1=null;fetch('/api/edit-request-1',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ads1:1,content1:'keep',tracking1:'seoul'})}).then(r=>r.json()).then(d=>{window.tjefr1=d;}).catch(()=>{});</script>요청 결과: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
    "verification": "jsonEquals:window.tjefr1:{\"content1\":\"keep\",\"tracking1\":\"seoul\"}:ads1 삭제됨"
  },
  {
