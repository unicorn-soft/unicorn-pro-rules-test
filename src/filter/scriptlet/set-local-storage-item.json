[
    {
        "id": "1",
        "title": "기본 localStorage 저장",
        "desc": "accepted 값을 slsi_basic에 저장하는 기본 동작을 확인합니다. 저장값이 accepted면 성공입니다.",
        "scriptlet": "set-local-storage-item",
        "scriptletParams": ["slsi_basic", "accepted"],
        "target": "<div class='target'></div>",
        "verification": "storageValue:slsi_basic:accepted"
    },
    {
        "id": "2",
        "title": "g 플래그 정규표현식 삭제",
        "desc": "테스트 실행 버튼을 누르면 slsi_regex_a1, a2, a3을 만든 뒤 정규표현식으로 삭제합니다. 세 키가 모두 삭제되면 성공입니다.",
        "scriptlet": "set-local-storage-item",
        "scriptletParams": ["/^slsi_regex_a/g", "$remove$"],
        "target": "<div class='target'></div>",
        "setup": {
            "slsi_regex_a1": "seed",
            "slsi_regex_a2": "seed",
            "slsi_regex_a3": "seed"
        },
        "verification": "probeRemovedStorage:slsi_regex_a1,slsi_regex_a2,slsi_regex_a3"
    },
    {
        "id": "3",
        "title": "reload 옵션",
        "desc": "slsi_reload=true가 저장된 뒤 약 5초 후 페이지가 새로고침되는지 확인합니다. 값 저장과 새로고침이 모두 확인되면 성공입니다.",
        "scriptlet": "set-local-storage-item",
        "scriptletParams": ["slsi_reload", "true", "reload", "5000"],
        "target": "<div class='target'></div>",
        "setup": { "slsi_reload": null },
        "verification": "reloadStorage:slsi_reload:true:8000"
    },
    {
        "id": "4",
        "title": "허용되지 않은 값 거부 (수동 확인)",
        "desc": "1. 규칙을 적용하고 Home에서 이 페이지를 다시 엽니다.<br>2. 개발자 도구의 Application > Storage > Local storage에서 slsi_invalid를 찾습니다.<br>3. 값이 original이면 성공, custom-value면 실패입니다.",
        "scriptlet": "set-local-storage-item",
        "scriptletParams": ["slsi_invalid", "custom-value"],
        "setup": { "slsi_invalid": "original" }
    }
]
