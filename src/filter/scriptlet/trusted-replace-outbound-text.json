        "scriptlet": "trusted-rpot",
        "scriptletParams": ["btoa", "ads", "removed", "ENCODING", "base64"],
        "target": "<div class='target'><script>window.trpot_1a = null;(function(){var container=document.currentScript.parentElement;var out=btoa('ads content');try{window.trpot_1a=atob(out);}catch(e){window.trpot_1a='';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
        "verification": "textEquals:window.trpot_1a:removed content"
    },
    {
        "id": "2",
        "title": "decodeURIComponent 숫자 제거",
        "desc": "decodeURIComponent 결과에서 숫자 제거",
        "scriptlet": "trusted-replace-outbound-text",
        "scriptletParams": ["decodeURIComponent", "/\\d+/", ""],
        "target": "<div class='target'><script>window.trpot_2 = null;(function(){var container=document.currentScript.parentElement;var enc=encodeURIComponent('Price 123');try{window.trpot_2=decodeURIComponent(enc);}catch(e){window.trpot_2='';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
        "verification": "textEquals:window.trpot_2:Price "
    },
    {
        "id": "3",
        "title": "decodeURIComponent + CONDITION",
        "desc": "'promo='가 포함될 때만 ads→removed 치환",
        "scriptlet": "trusted-replace-outbound-text",
        "scriptletParams": [
            "decodeURIComponent",
            "ads",
            "removed",
            "CONDITION",
            "promo="
        ],
        "target": "<div class='target'><script>window.trpot_3 = null;(function(){var container=document.currentScript.parentElement;var dec=decodeURIComponent('promo%3Dads');window.trpot_3=dec;}())</script>Outbound 텍스트: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
        "verification": "textEquals:window.trpot_3:promo=removed"
    },
    {
        "id": "4",
        "title": "atob 기본 치환",
