    {
        "id": "2",
        "title": "decodeURIComponent + CONDITION(정규식): 숫자 제거",
        "desc": "CONDITION=Price일 때만 /\\d+/ 제거가 적용되고, 조건 불만족(Cost)은 원본을 유지",
        "scriptlet": "trusted-replace-outbound-text",
        "scriptletParams": [
            "decodeURIComponent",
            "/\\d+/",
            "''",
            "CONDITION",
            "Price"
        ],
        "target": "<div class='target'><script>window.trpot_2 = null;(function(){try{const withCond=decodeURIComponent(encodeURIComponent('Price 123'));const withoutCond=decodeURIComponent(encodeURIComponent('Cost 123'));window.trpot_2=withCond+'||'+withoutCond;}catch(e){window.trpot_2='';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br></div>",
        "verification": "textEquals:window.trpot_2:Price ||Cost 123"
    },
    {
