        "target": "<div class='target'><script>window.trpot_2 = null;window.trpot_2_flag = null;(function(){try{const withCond=decodeURIComponent(encodeURIComponent('Price TRPOT2_123'));const withoutCond=decodeURIComponent(encodeURIComponent('Cost TRPOT2_123'));window.trpot_2=withCond+'||'+withoutCond;const ok=withCond.startsWith('Price') && !withCond.includes('TRPOT2_123') && withoutCond.startsWith('Cost') && withoutCond.includes('TRPOT2_123');window.trpot_2_flag=ok?'OK':'NG';}catch(e){window.trpot_2='';window.trpot_2_flag='NG';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br></div>",
        "verification": "textEquals:window.trpot_2_flag:OK"
    },
