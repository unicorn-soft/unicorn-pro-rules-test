[
    {
        "id": "1",
        "title": "btoa + ENCODING(base64) 치환 (풀네임 'trusted-replace-outbound-text' 사용)",
        "desc": "btoa 결과를 base64 decode→치환→encode 과정으로 'ads'를 'removed'로 변경",
        "scriptlet": "trusted-replace-outbound-text",
        "scriptletParams": ["btoa", "ads", "removed", "ENCODING", "base64"],
        "target": "<div class='target'><script>window.trpot_1 = null;(function(){var container=document.currentScript.parentElement;var out=btoa('ads content');try{window.trpot_1=atob(out);}catch(e){window.trpot_1='';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
        "verification": "textEquals:window.trpot_1:removed content"
    },
    {
        "id": "1-alias",
        "title": "btoa + ENCODING(base64) 치환 (별칭 'trusted-rpot' 사용)",
