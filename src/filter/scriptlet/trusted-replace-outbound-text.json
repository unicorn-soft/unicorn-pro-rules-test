        "target": "<div class='target'><script>window.trpot_3 = null;(function(){try{const withCond=decodeURIComponent(encodeURIComponent('TRPOT3_COND TRPOT3_ADS'));const withoutCond=decodeURIComponent(encodeURIComponent('TRPOT3_ADS'));window.trpot_3=withCond+'||'+withoutCond;}catch(e){window.trpot_3='';}}())</script>Outbound 텍스트: <span class='status'>대기중</span><br></div>",
        "verification": "textEquals:window.trpot_3:TRPOT3_COND TRPOT3_REPL||TRPOT3_ADS"
