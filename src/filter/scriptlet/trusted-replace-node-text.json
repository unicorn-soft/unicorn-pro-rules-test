    {
        "id": "8",
        "title": "stay 옵션 (지속 감시)",
        "desc": "DOMContentLoaded 이후에도 치환 감시 유지 (stay 옵션)",
        "scriptlet": "trusted-replace-node-text",
        "scriptletParams": ["DIV", "LaterStay", "ReplacedStay", "STAY", "1"],
        "target": "<div class='target'><script>window.rpnt_8=null;(function(){const container=document.currentScript.parentElement;const el=document.createElement('div');el.textContent='LaterStay change pending';container.appendChild(el);const update=function(){window.rpnt_8=el.textContent;};update();const mo=new MutationObserver(function(){update();});mo.observe(el,{childList:true,subtree:true});const changeAfterDCL=function(){setTimeout(function(){el.textContent='LaterStay arrived';if(el.parentNode){const parent=el.parentNode;parent.removeChild(el);parent.appendChild(el);}},50);};if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',changeAfterDCL);}else{changeAfterDCL();}})();</script></div>",
        "verification": "textEquals:window.rpnt_8:ReplacedStay arrived"
    },
    {
