    {
        "id": "5",
        "title": "#text 노드 치환",
        "desc": "텍스트 노드의 'ads-text'를 'removed'로 치환",
        "scriptlet": "trusted-replace-node-text",
        "scriptletParams": ["#text", "ads-text", "removed"],
        "target": "<div class='target'><div id='rpnt_5_wrap'></div><script>window.rpnt_5 = null;(function(){const wrap=document.getElementById('rpnt_5_wrap');if(!wrap)return;const textNode=document.createTextNode('This has ads-text here');wrap.appendChild(textNode);const update=function(){window.rpnt_5=textNode.textContent;};update();const mo=new MutationObserver(function(){update();mo.disconnect();});mo.observe(textNode,{characterData:true});}())</script></div>",
        "verification": "textEquals:window.rpnt_5:This has removed here"
    },
    {
