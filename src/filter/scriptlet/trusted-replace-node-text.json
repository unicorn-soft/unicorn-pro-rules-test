        "target": "<div class='target'><script>window.rpnt_1 = null;(function(){const container=document.currentScript.parentElement;const el=document.createElement('div');el.textContent='This content has ads-base content';container.appendChild(el);const update=function(){window.rpnt_1=el.textContent;};update();const mo=new MutationObserver(function(){update();mo.disconnect();});mo.observe(el,{childList:true,subtree:true});}())</script></div>",
        "verification": "textEquals:window.rpnt_1:This content has removed content"
    },
