        ],
        "target": "<div class='target'><script id='rpnt_10_target'>(function test10(){window.testValue=false;})();</script><script>window.rpnt_10=null;setTimeout(function(){const target=document.getElementById('rpnt_10_target');const source=target?target.textContent:'';window.rpnt_10=source.includes(';(function(){window.testValue=true;})();(funciton test10()')?'ok':'fail';},300);</script></div>",
        "verification": "textEquals:window.rpnt_10:ok"
    }
