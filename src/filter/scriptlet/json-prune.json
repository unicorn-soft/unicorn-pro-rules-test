        "target": "<div class='target'><script>window.jsonPruneTestData5 = '{\"tracking5\": {\"video5\": {\"ads5\": 1, \"content5\": \"집\"}, \"display5\": {\"ads5\": 2, \"content5\": \"회사\"}}}'; window.jsonPruneParsedData5 = null; setTimeout(() => { try { window.jsonPruneParsedData5 = JSON.parse(window.jsonPruneTestData5); } catch(e) {} }, 100);</script>JSON 파싱 결과: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
