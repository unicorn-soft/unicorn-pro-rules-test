[
    {
        "id": "1",
        "title": "기본 속성 제거",
        "desc": "최상위 속성 ads1, tracking1 제거",
        "scriptlet": "json-prune",
        "scriptletParams": ["ads1 tracking1"],
        "target": "<div class='target'><script>window.jsonPruneTestData1 = '{\"ads1\": 123, \"content1\": \"test\", \"tracking1\": \"seoul\"}'; window.jsonPruneParsedData1 = null; try { window.jsonPruneParsedData1 = JSON.parse(window.jsonPruneTestData1); } catch(e) {}</script>JSON 파싱 결과: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
        "verification": "jsonEquals:window.jsonPruneParsedData1:{\"content1\":\"test\"}"
    },
    {
        "id": "2",
        "title": "중첩 객체 속성 제거",
