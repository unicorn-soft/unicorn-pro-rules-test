        "desc": "배열의 모든 요소에서 tracking4 제거",
        "scriptlet": "json-prune",
        "scriptletParams": ["[].tracking4"],
        "target": "<div class='target'><script>window.jsonPruneTestData4 = '[{\"ads4\": 1, \"tracking4\": \"seoul\"}, {\"ads4\": 2, \"tracking4\": \"busan\"}]'; window.jsonPruneParsedData4 = null; setTimeout(() => { try { window.jsonPruneParsedData4 = JSON.parse(window.jsonPruneTestData4); } catch(e) {} }, 100);</script>JSON 파싱 결과: <span class='status'>대기중</span><br><pre class='json-result'></pre></div>",
