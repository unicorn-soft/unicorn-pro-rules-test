        "scriptlet": "trusted-replace-fetch-response",
        "scriptletParams": ["tracking", "removed", "url:/api/replace-data3"],
        "target": "<div class='target'><script>window.trfr_3=null;Promise.all([fetch('/api/replace-data3').then(res=>res.text()).catch(()=>null),fetch('/api/replace-control3').then(res=>res.text()).catch(()=>null)]).then(([a,b])=>{if(a===null||b===null)return;window.trfr_3=a+'||'+b;}).catch(()=>{});</script>Fetch 응답 결과: <span class='status'>대기중</span><br></div>",
        "verification": "textEquals:window.trfr_3:This has removed code||Control has tracking code"
    },
