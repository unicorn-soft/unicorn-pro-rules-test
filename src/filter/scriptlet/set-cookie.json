[
    {
        "id": "1",
        "title": "기본 쿠키 저장",
        "desc": "accepted 값을 sc_basic 쿠키에 저장하는 기본 동작을 확인합니다. 쿠키값이 accepted면 성공입니다.",
        "scriptlet": "set-cookie",
        "scriptletParams": ["sc_basic", "accepted"],
        "target": "<div class='target'></div>",
        "verification": "cookieValue:sc_basic:accepted"
    },
    {
        "id": "2",
        "title": "path 옵션",
        "desc": "path=none으로 Path 속성을 생략했을 때 브라우저의 기본 경로가 적용되는지 확인합니다. sc_path=accepted이고 Path가 현재 페이지의 기본 경로면 성공입니다.",
        "scriptlet": "set-cookie",
        "scriptletParams": ["sc_path", "accepted", "none"],
        "target": "<div class='target'></div>",
        "verification": "cookieAttribute:sc_path:accepted:path:default"
    },
    {
        "id": "3",
        "title": "dontOverwrite 옵션",
        "desc": "테스트 실행 버튼을 누르면 쿠키가 없을 때 rejected가 생성되는지 먼저 확인합니다. 이후 기존값 accepted가 rejected로 덮어써지지 않으면 성공입니다.",
        "scriptlet": "set-cookie",
        "scriptletParams": [
            "sc_dont_overwrite",
            "rejected",
            "",
            "dontOverwrite",
            "1"
        ],
        "target": "<div class='target'></div>",
        "setup": { "sc_dont_overwrite": "accepted" },
        "verification": "probeDontOverwriteCookie:sc_dont_overwrite:accepted:rejected"
    },
    {
        "id": "4",
        "title": "reload 옵션",
        "desc": "sc_reload=true가 저장된 뒤 페이지가 실제로 새로고침되는지 확인합니다. 값 저장과 새로고침이 모두 확인되면 성공입니다.",
        "scriptlet": "set-cookie",
        "scriptletParams": ["sc_reload", "true", "", "reload", "1"],
        "target": "<div class='target'></div>",
        "setup": { "sc_reload": null },
        "verification": "reloadCookie:sc_reload:true:10000"
    },
    {
        "id": "5",
        "title": "허용되지 않은 값 거부 (수동 확인)",
        "desc": "1. 규칙을 적용하고 Home에서 이 페이지를 다시 엽니다.<br>2. 개발자 도구의 Application > Storage > Cookies에서 sc_invalid를 찾습니다.<br>3. 값이 original이면 성공, custom-value면 실패입니다.",
        "scriptlet": "set-cookie",
        "scriptletParams": ["sc_invalid", "custom-value"],
        "setup": { "sc_invalid": "original" }
    }
]
